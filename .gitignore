# Build artifacts — regenerated every run, never source.
#
# The play-by-play file alone is ~13 MB and would churn daily. In CI these are
# fetched fresh (or restored from the Actions cache), so nothing here is lost.
# Paths follow sag.config.LeagueConfig's convention: everything fetched for a
# league lives under sites/<slug>/data/, which is also what the Actions cache
# key names (D12) — so a new data file is covered here and cached there without
# anyone remembering to add it.
*.csv
sites/*/data/

# ...but hand-maintained reference data is SOURCE, not an artifact. The rule is
# provenance, not extension: anything under sites/<slug>/reference/ is typed by a
# human, has no upstream to re-fetch it from, and is lost forever if it isn't
# tracked. (wnba_coaches_2026.csv is the first of these.)
!sites/*/reference/
!sites/*/reference/*.csv
sites/*/*-stats-explorer.html
sites/*/social_payload.json
sites/*/preview/
# Golden-harness snapshot + pinned renders (golden_check.py) — local dev tool;
# no fetched CSVs are committed to this public repo.
sites/*/golden/

# Local secrets. THIS REPO IS PUBLIC. In CI these come from repo secrets.
.env
.dev.vars

# Cloudflare Workers local build cache.
#
# THE RULE: every Worker's SOURCE (worker.js + wrangler.toml) is tracked —
# only the cache is ignored. Secrets live solely in `wrangler secret put`.
#
# Workers in this repo:
#   workers/cron/       deployed — build dispatch + health checks
#   workers/analytics/  deployed — usage beacon
#   workers/espn-proxy/ NOT deployed — contingency only
#
# analytics-worker/ sat untracked from 2026-07-12 to 2026-08-05: nothing was
# ignoring it, it was just never `git add`ed. Hence the explicit list — add to
# it when you add a Worker.
#
# NONE of these are deployed by CI. The Action's `wrangler deploy` ships the
# WNBA site only (sites/wnba/wrangler.toml); a Worker change needs a manual
# `wrangler deploy` from its own directory that nothing will remind you to do.
.wrangler/

# Python
core/*.egg-info/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Tooling / OS
.claude/
.Rhistory
.DS_Store

# NOTE ON WHAT IS NO LONGER HERE (2026-08-07 workspace migration).
#
# This file used to carry a deny-list of private documents living inside a
# PUBLIC repo: COLUMN-REDESIGN.*, WNBA-STATS-EXPLORER.md, CLAUDE.md,
# 'Product Archive/', bluesky-briefs/, *prototype*, *.xlsx. Those files now
# live in the private statsataglance-docs and wbb-lab repos, so the entries
# protecting them are obsolete.
#
# A deny-list is the wrong tool for that job and had already failed in both
# directions. Every boundary is now a directory boundary AND a git boundary on
# the same line. Keep it that way: if something private turns up here, move it
# out rather than adding a line below.
